{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zena-ltd",
  "main": "src/worker.js",
  "compatibility_date": "2025-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "39126f63c29641e48d9756ffaebc2e38"
    }
  ]
}
